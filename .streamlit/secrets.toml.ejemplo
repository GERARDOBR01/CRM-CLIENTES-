# Copia este archivo como `.streamlit/secrets.toml` y llena lo que uses.
# secrets.toml está en .gitignore: NUNCA se sube al repo.
#
# En Streamlit Community Cloud estos mismos valores se pegan en
# Settings -> Secrets de la app (no se sube el archivo).

# Contraseña para entrar al CRM. Si está vacía o no existe, la app no la pide
# (que es lo que quieres en localhost). En la nube, ponla sí o sí.
CRM_PASSWORD = ""

# Token de la API de Goatcounter, para saber si abrieron el diagnóstico.
# Se saca en: tu-sitio.goatcounter.com -> Settings -> API tokens (permiso de "Read statistics").
GOATCOUNTER_TOKEN = ""

# Solo si migras a Postgres/Supabase. Vacío = SQLite local (leads.db).
# Formato: postgresql://usuario:password@host:5432/postgres
DATABASE_URL = ""
